# 依赖
node_modules/
.pnpm-store/
.bun/
.bun-tmp/
.bun-home/

# 构建产物：lib/ 需要提交（发布时用户无需再 build）
# 仅忽略 sourcemap 与临时构建文件
lib/*.map
dist/

# 测试/覆盖率
coverage/
.nyc_output/

# 锁文件（按项目实际使用保留 pnpm-lock.yaml）
bun.lock
bun.lockb
package-lock.json
yarn.lock

# 环境/临时文件
.env
.env.local
*.log
.DS_Store
Thumbs.db
*.swp
*.swo
*.tsbuildinfo

# DSH 本地配置
*.local.jsonc
